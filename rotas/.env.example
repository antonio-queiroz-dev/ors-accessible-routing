# API Spring Boot
API_PORTA=8080
API_JAVA_OPTS=-Xmx384m
API_FUSO=America/Bahia

# openrouteservice: API pública (chave em https://openrouteservice.org/dev). Nunca commitar a chave.
ORS_URL=https://api.openrouteservice.org
ORS_API_KEY=
# Plano B (ORS próprio): ORS_URL=http://ors:8082/ors e "docker compose --profile ors-local up -d"

# Back da câmera: endereço que lista obstáculos (a API acrescenta ?bbox=minLon,minLat,maxLon,maxLat).
# Vazio: usa os obstáculos de teste fixos.
CAMERA_URL=

# Área atendida (minLon,minLat,maxLon,maxLat): origem ou destino fora dela dão 400.
# Vazio = mundo todo. Sem a linha = Centro Histórico de Salvador
AREA_BBOX=
AREA_NOME=Centro Histórico de Salvador

# Domínios do front que podem chamar a API, separados por vírgula ("*" libera todos)
CORS_ORIGENS=*

# Página de teste com mapa em "/" (false esconde; a API e o Swagger continuam)
PAGINA_TESTE=true

# Rota
ROTA_PERFIS=wheelchair,foot-walking
ROTA_CONFIANCA_MINIMA=0.6
# Lado do quadrado de cada obstáculo (cobre o erro do GPS)
ROTA_LADO_QUADRADO_METROS=12
# Passagem difícil: aceita o desvio se aumentar a rota em até X%, ou em até Y metros (o que for maior)
ROTA_DESVIO_PERCENTUAL=30
ROTA_DESVIO_PISO_METROS=100

# Legado (ORS próprio, só para o plano B e para medir.sh/recortar.sh)
OSM_REGIAO_URL=https://download.geofabrik.de/south-america/brazil/nordeste-latest.osm.pbf
OSM_REGIAO_ARQUIVO=nordeste-latest.osm.pbf
CIDADE_NOME=salvador
CIDADE_BBOX=-38.6995,-13.0174,-38.3034,-12.7336
ORS_VERSAO=v10.1.0
ORS_PORTA=8082
ORS_PBF=salvador.osm.pbf
ORS_XMS=256m
ORS_XMX=2g
ORS_PERFIL_FOOT_WALKING=true
ORS_PERFIL_WHEELCHAIR=true
